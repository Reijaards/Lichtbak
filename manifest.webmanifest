{
  "name": "Lichtbak",
  "short_name": "Lichtbak",
  "description": "Foto's bewerken op je telefoon en pc, ook offline. Je foto's blijven op je eigen apparaat.",
  "lang": "nl",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#141518",
  "theme_color": "#141518",
  "categories": ["photo", "productivity"],
  "icons": [
    {"src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{"name": "photos", "accept": ["image/*", ".jpg", ".jpeg", ".png", ".webp"]}]
    }
  }
}
